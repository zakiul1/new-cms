# --------------------------------------------
# Laravel / PHP
# --------------------------------------------
/vendor/
/composer.lock

# Env files (never commit secrets)
.env
.env.*
!.env.example

# Laravel caches / runtime
/bootstrap/cache/*.php
/storage/framework/*
!/storage/framework/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# Laravel storage links / generated
/public/storage
/public/hot

# Keys / certs
/storage/*.key

# Auth / credentials files
/auth.json

# PHPUnit / testing caches
.phpunit.result.cache
/.phpunit.cache/
coverage/
*.cache

# Logs
*.log

# --------------------------------------------
# Node / frontend
# --------------------------------------------
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs (optional but common)
# Uncomment if you build locally and don't want to commit built assets:
# /public/build/
# /public/mix-manifest.json

# --------------------------------------------
# IDEs / editors
# --------------------------------------------
/.idea/
/.vscode/
/.zed/
/.fleet/
/.nova/
*.iml

# --------------------------------------------
# OS junk
# --------------------------------------------
.DS_Store
Thumbs.db

# --------------------------------------------
# Local dev environments
# --------------------------------------------
Homestead.json
Homestead.yaml

# --------------------------------------------
# Misc
# --------------------------------------------
.phpactor.json